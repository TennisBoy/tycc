    "oidc-client-ts": "^3.4.1",
    "qs": "^6.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-oidc-context": "^3.3.0",
    "react-router": "^7.13.1",
