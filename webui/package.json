{
  "name": "tycc-webui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "codegen": "npm run codegen:products",
    "codegen:products": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-typescript http://localhost:5000/swagger/products/swagger.json -o src/types/generated/products.ts"
